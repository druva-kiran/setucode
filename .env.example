# ==============================================================================
# SetuCode Environment Configuration
# Copy this file to .env and customize as needed.
# ==============================================================================

# LLM Provider: claude | openai | gemini | ollama | openrouter
LLM_PROVIDER=claude
LLM_MODEL=claude-3-5-sonnet-20241022

# Workspace boundary
WORKSPACE_ROOT=./workspace

# ------------------------------------------------------------------------------
# 1. Anthropic (Claude)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional custom endpoint / proxy:
# ANTHROPIC_BASE_URL=https://your-anthropic-proxy.com

# ------------------------------------------------------------------------------
# 2. OpenAI & OpenAI-Compatible Custom Endpoints
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
# Custom endpoints (Ollama, LMStudio, OpenRouter, vLLM, LocalAI):
# Ollama:      OPENAI_BASE_URL=http://localhost:11434/v1
# OpenRouter:  OPENAI_BASE_URL=https://openrouter.ai/api/v1
# LMStudio:    OPENAI_BASE_URL=http://localhost:1234/v1
# vLLM:        OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_BASE_URL=

# ------------------------------------------------------------------------------
# 3. Google Gemini
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
# Optional custom Gemini endpoint / proxy:
# GEMINI_BASE_URL=https://your-gemini-proxy.com

# ------------------------------------------------------------------------------
# 4. Custom Skills Directories (Optional)
# In addition to .agents/skills, skills/, and workspace/.agents/skills,
# you can specify additional paths separated by semicolon or colon:
# SKILLS_PATH=/path/to/my-skills;/path/to/team-skills
# ------------------------------------------------------------------------------
# SKILLS_PATH=
